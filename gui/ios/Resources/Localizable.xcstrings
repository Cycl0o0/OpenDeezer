    "Let your other OpenDeezer devices (same Deezer account) find this iPhone and control its playback over the local network.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لأجهزة OpenDeezer الأخرى (بنفس حساب Deezer) بالعثور على هذا الـ iPhone والتحكم في تشغيله عبر الشبكة المحلية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que tus otros dispositivos OpenDeezer (con la misma cuenta de Deezer) encuentren este iPhone y controlen su reproducción a través de la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à vos autres appareils OpenDeezer (même compte Deezer) de détecter cet iPhone et de contrôler sa lecture sur le réseau local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने अन्य OpenDeezer डिवाइस (उसी Deezer खाते वाले) को लोकल नेटवर्क पर इस iPhone को खोजने और इसका प्लेबैक नियंत्रित करने दें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет другим вашим устройствам OpenDeezer (с тем же аккаунтом Deezer) находить этот iPhone и управлять воспроизведением по локальной сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你的其他 OpenDeezer 设备（同一 Deezer 账户）通过局域网发现这台 iPhone 并控制其播放。"
          }
        }
      }
    },
    "Library": {
      "extractionState": "manual",
