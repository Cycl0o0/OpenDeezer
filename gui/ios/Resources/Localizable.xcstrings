          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDeezer reproduce canciones completas con tu cuenta de Deezer, lo que requiere un plan de pago (Premium, Family o HiFi)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDeezer diffuse les titres complets avec votre compte Deezer, ce qui nécessite un abonnement payant (Premium, Family ou HiFi)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDeezer आपके Deezer खाते से पूरे ट्रैक स्ट्रीम करता है, जिसके लिए सशुल्क प्लान (Premium, Family या HiFi) आवश्यक है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDeezer воспроизводит полные треки через ваш аккаунт Deezer — для этого нужен платный тариф (Premium, Family или HiFi)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenDeezer 使用你的 Deezer 账户播放完整歌曲，这需要付费方案（Premium、Family 或 HiFi）。"
          }
        }
      }
    },
