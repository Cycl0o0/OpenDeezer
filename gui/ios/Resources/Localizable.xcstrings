    "Pause playback after a set time (with a gentle fade-out) or when the current track ends.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف التشغيل مؤقتًا بعد مدة محددة (مع خفوت تدريجي لطيف) أو عند انتهاء الأغنية الحالية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa la reproducción tras un tiempo determinado (con un fundido suave) o al terminar la canción actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met la lecture en pause après une durée définie (avec un léger fondu) ou à la fin du titre en cours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तय समय के बाद (हल्के फ़ेड-आउट के साथ) या मौजूदा ट्रैक समाप्त होने पर प्लेबैक रोकें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливает воспроизведение через заданное время (с плавным затуханием) или по окончании текущего трека."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设定时间后（伴随轻柔的淡出）或当前歌曲结束时暂停播放。"
          }
        }
      }
    },
