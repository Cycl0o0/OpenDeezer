    "Lower the preamp if boosted bands make loud tracks clip.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخفض التضخيم المسبق إذا تسببت النطاقات المعزَّزة في تشويه الأغاني الصاخبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el preamplificador si las bandas realzadas hacen que las canciones altas distorsionen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baissez le préampli si des bandes amplifiées font saturer les titres forts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि बूस्ट किए गए बैंड से तेज़ आवाज़ वाले ट्रैक में आवाज़ फटती है, तो प्रीएम्प कम करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшите предусиление, если из-за усиленных полос громкие треки искажаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果增强的频段导致大声的歌曲破音，请调低前置放大。"
          }
        }
      }
    },
