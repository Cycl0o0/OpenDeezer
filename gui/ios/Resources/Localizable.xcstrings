        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लाइब्रेरी, प्लेलिस्ट और Flow स्ट्रीम करने के लिए अपने Deezer खाते से साइन इन करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
