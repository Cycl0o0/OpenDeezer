    "Adjusting a band switches the preset to Custom.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تعديل أي نطاق يتحول الإعداد المسبق إلى «مخصص»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al ajustar una banda, el preajuste cambia a Personalizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage d'une bande fait passer le préréglage sur Personnalisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी बैंड को समायोजित करने पर प्रीसेट “कस्टम” में बदल जाता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При изменении полосы пресет переключается на «Пользовательский»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整任一频段后，预设将切换为“自定义”。"
          }
        }
      }
    },
